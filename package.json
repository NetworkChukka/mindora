{
  "name": "mindora-system",
  "version": "1.0.0",
  "description": "MINDORA Microbiology Exhibition Offline LAN Registration & Management System",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "dev:server": "nodemon server/server.js",
    "dev:client": "cd client && npm run dev",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build:client": "cd client && npm run build",
    "build": "npm run build:client",
    "desktop": "electron desktop/main.js",
    "seed": "node scripts/seed.js",
    "test": "node tests/acceptance.test.js"
  },
  "keywords": ["mindora", "microbiology", "exhibition", "registration", "offline-lan", "mongodb"],
  "author": "MINDORA Technical Team",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "csv-parser": "^3.0.0",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.6.1",
    "multer": "^1.4.5-lts.1",
    "pdfkit": "^0.15.0",
    "qrcode": "^1.5.4",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.1.4"
  }
}
